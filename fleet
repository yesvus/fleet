#!/usr/bin/env bash
# fleet - Beszel 0.19.0 hub status from the CLI, no dashboard password needed.
# Reads the hub SQLite DB over SSH (read-only) and prints latest 1m stats.
#
# Usage: fleet [OPTIONS] [FILTER]
#   FILTER                only show systems whose name contains FILTER
# Options:
#   --json                machine-readable JSON (for agents/pipes)
#   --host HOST           ssh target for the hub (default: jelly)
#   --db PATH             hub SQLite path (default: /opt/beszel/beszel_data/data.db)
#   --color=WHEN          color table output: auto (default), always, never
#   -h, --help            show this help and exit
#   -v, --version         show version and exit
# Env: BESZEL_SSH_HOST, BESZEL_DB override the defaults.
#   NO_COLOR disables color. JSON output is never colored.
# Examples:
#   fleet                 table of all systems
#   fleet toa             table, only matching names
#   fleet --json          JSON array, all systems (pipe to jq)
set -euo pipefail

VERSION="0.4.0"
HOST="${BESZEL_SSH_HOST:-jelly}"
DB="${BESZEL_DB:-/opt/beszel/beszel_data/data.db}"
JSON=0
COLOR="auto"
FILTER=""
FILTER_SET=""

usage() { sed -n '2,19p' "$0" | sed 's/^# \?//'; }

die() { echo "fleet: $1" >&2; exit "${2:-1}"; }

set_filter() {
  if [ -n "$FILTER_SET" ]; then
    die "only one FILTER allowed (see --help)" 2
  fi
  FILTER="$1"
  FILTER_SET=1
}

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -v|--version) echo "fleet $VERSION"; exit 0 ;;
    --json) JSON=1; shift ;;
    --host) HOST="${2:?--host needs a value}"; shift 2 ;;
    --host=*) HOST="${1#--host=}"; shift ;;
    --db) DB="${2:?--db needs a value}"; shift 2 ;;
    --db=*) DB="${1#--db=}"; shift ;;
    --color) COLOR="${2:?--color needs a value}"; shift 2 ;;
    --color=*) COLOR="${1#--color=}"; shift ;;
    --) shift
      if [ $# -gt 1 ]; then
        die "only one FILTER allowed (see --help)" 2
      fi
      if [ $# -eq 1 ]; then set_filter "$1"; fi
      break ;;
    -*) die "unknown flag: $1 (see --help)" 2 ;;
    *) set_filter "$1"; shift ;;
  esac
done

case "$COLOR" in
  auto|always|never) ;;
  *) die "bad --color value: $COLOR (want auto, always, never)" 2 ;;
esac

command -v ssh >/dev/null || die "need ssh installed (openssh-client)"
command -v python3 >/dev/null || die "need python3 installed (>= 3.7)"

if [ "$COLOR" = "always" ]; then
  USE_COLOR=1
elif [ "$COLOR" = "never" ]; then
  USE_COLOR=0
elif [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != "dumb" ]; then
  USE_COLOR=1
else
  USE_COLOR=0
fi

ssh -o ConnectTimeout=5 "$HOST" command -v sqlite3 >/dev/null \
  || die "cannot use $HOST (ssh failed or sqlite3 missing there)"

DB_Q="$(printf '%q' "$DB")"
SQL="SELECT s.name,s.status,s.host,st.updated,st.stats FROM systems s LEFT JOIN (SELECT system,max(updated) AS mu FROM system_stats WHERE type='1m' GROUP BY system) l ON l.system=s.id LEFT JOIN system_stats st ON st.system=l.system AND st.updated=l.mu;"

ROWS="$(ssh -o ConnectTimeout=5 "$HOST" "sqlite3 -cmd '.timeout 5000' -json $DB_Q \"$SQL\"")" \
  || die "failed to query hub via $HOST"

export FLEET_FILTER="$FILTER" FLEET_JSON="$JSON" FLEET_COLOR="$USE_COLOR"
echo "$ROWS" | python3 -c "
import json, os, sys
from datetime import datetime

f = os.environ.get('FLEET_FILTER', '').lower()
want_json = os.environ.get('FLEET_JSON') == '1'
use_color = os.environ.get('FLEET_COLOR') == '1'

def c(code, text):
    return '\x1b[%sm%s\x1b[0m' % (code, text) if use_color else text

def pct(v, suffix='%', ref=None):
    if v is None:
        return '-'
    t = '%s%s' % (v, suffix)
    cval = ref if ref is not None else v
    if isinstance(cval, (int, float)):
        if cval >= 90:
            return c('31', t)
        if cval >= 75:
            return c('33', t)
    return t

def status(s):
    s = '%-4s' % s
    if s.strip() == 'up':
        return c('32', s)
    if s.strip() == 'down':
        return c('31', s)
    return c('33', s)

try:
    rows = json.load(sys.stdin)
except json.JSONDecodeError as e:
    print(f'fleet: hub returned invalid JSON: {e}', file=sys.stderr)
    sys.exit(1)
if not isinstance(rows, list):
    print('fleet: hub returned unexpected data (not a list)', file=sys.stderr)
    sys.exit(1)

out = []
for r in sorted(rows, key=lambda x: (x.get('name') or '')):
    name = r.get('name') or '?'
    if f and f not in name.lower():
        continue
    try:
        s = json.loads(r['stats']) if r.get('stats') else {}
        if not isinstance(s, dict):
            s = {}
    except (json.JSONDecodeError, TypeError):
        print(f'fleet: warning: {name} has a bad stats blob, showing blanks', file=sys.stderr)
        s = {}
    ts = ''
    if r.get('updated'):
        try:
            ts = datetime.fromisoformat(str(r['updated']).replace('Z', '+00:00')).strftime('%H:%M:%S')
        except ValueError:
            ts = str(r['updated'])
    out.append({'name': name, 'status': r.get('status') or '?', 'host': r.get('host') or '-',
                'updated': r.get('updated'), 'ts': ts or '-',
                'cpu_pct': s.get('cpu'), 'mem_pct': s.get('mp'),
                'mem_used_gb': s.get('mu'), 'disk_pct': s.get('dp'),
                'disk_used_gb': s.get('du'), 'load': s.get('la')})

if not out:
    if f:
        print('fleet: no systems match \'%s\'' % os.environ['FLEET_FILTER'], file=sys.stderr)
    else:
        print('fleet: hub has no systems', file=sys.stderr)
    sys.exit(1)

if want_json:
    print(json.dumps([{k: e[k] for k in ('name', 'status', 'host', 'updated', 'cpu_pct',
        'mem_pct', 'mem_used_gb', 'disk_pct', 'disk_used_gb', 'load')} for e in out], indent=1))
else:
    w = max([8] + [len(e['name']) for e in out])
    for e in out:
        upd = e['ts'] + 'Z' if e['ts'] != '-' else '-'
        load = e['load'] if e['load'] is not None else '-'
        print('%-*s %s cpu=%s mem=%s (%s) disk=%s (%s) load=%s updated=%s' % (
            w, e['name'], status(e['status']), pct(e['cpu_pct']), pct(e['mem_pct']),
            pct(e['mem_used_gb'], 'G', e['mem_pct']), pct(e['disk_pct']), pct(e['disk_used_gb'], 'G', e['disk_pct']),
            load, upd))
"
